{
  "manifest_version": 3,
  "name": "Arc Video Keepalive",
  "version": "2.1.0",
  "description": "動画再生中に GPU をアイドルに落とさず、USB オーディオの途切れを防ぐ",
  "permissions": ["storage"],
  "action": {
    "default_title": "Arc Video Keepalive",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
